source "https://rubygems.org"

# Jekyll (version compatible GitHub Pages)
gem "jekyll", "~> 4.3"

# Theme
gem "just-the-docs"

# Plugins
group :jekyll_plugins do
  gem "jekyll-seo-tag"
  gem "jekyll-sitemap"
  gem "jekyll-github-metadata"
  gem "jekyll-include-cache"
end

# Windows support (si tu es sous Windows)
platforms :mingw, :x64_mingw, :mswin do
  gem "tzinfo-data"
end
